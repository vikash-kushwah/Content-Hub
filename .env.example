# ── Database ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/devdocs

# ── Authentication ───────────────────────────────────────────────────────────────
# Admin panel password (required — set a strong secret)
ADMIN_PASSWORD=change-me-in-production

# ── Session ──────────────────────────────────────────────────────────────────────
# Secure random string used to sign sessions (required)
SESSION_SECRET=change-me-in-production

# ── Site metadata ────────────────────────────────────────────────────────────────
# Canonical origin used in sitemap, RSS, and JSON-LD (optional — defaults to devdocs.replit.app)
# SITE_URL=https://yourdomain.com

# ── Server ───────────────────────────────────────────────────────────────────────
# API server port (optional — Replit sets this automatically via workflow)
# PORT=8080

# ── Environment ──────────────────────────────────────────────────────────────────
NODE_ENV=development
