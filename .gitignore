# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Build outputs ──────────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
build/
*.tsbuildinfo
.expo/
.expo-shared/

# ── Dependencies ────────────────────────────────────────────────────────────────
node_modules/

# ── Environment variables & secrets ────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test & coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── IDEs and editors ────────────────────────────────────────────────────────────
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── OS generated ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Misc ────────────────────────────────────────────────────────────────────────
/.sass-cache/
/connect.lock/
/libpeerconnection.log
/typings/

# ── Replit ──────────────────────────────────────────────────────────────────────
.cache/
.local/
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
